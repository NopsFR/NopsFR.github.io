---
// src/components/AtmosphericBackground.astro
// A continuously-flowing WebGL plasma field in the site's own accent colours
// (red/cyan/gold) — real, visible motion, not a static blob or a dot/particle
// field. Renders at reduced internal resolution and upscaled via CSS for
// performance; falls back to a still CSS gradient if WebGL is unavailable.
// A single static frame is drawn under prefers-reduced-motion.
---

<div class="atmosphere" aria-hidden="true">
  <div class="fallback"></div>
  <canvas data-shader-canvas class="shader-canvas"></canvas>
  <div class="scrim"></div>
</div>

<script>
  const idle = (cb: () => void) => {
    const ric = (window as typeof window & { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback;
    if (ric) ric(cb);
    else window.setTimeout(cb, 50);
  };

  idle(() => {
    import('../scripts/shader-background').then(({ mountShaderBackground }) => {
      const cleanup = mountShaderBackground('[data-shader-canvas]');
      if (cleanup) document.querySelector('[data-shader-canvas]')?.classList.add('is-active');
    });
  });
</script>

<style>
  .atmosphere {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--color-bg);
  }

  .fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 15% 10%, color-mix(in srgb, var(--color-accent-interactive) 20%, transparent), transparent 60%),
      radial-gradient(ellipse 65% 55% at 90% 85%, color-mix(in srgb, var(--color-accent-secondary) 16%, transparent), transparent 60%),
      var(--color-bg);
  }

  .shader-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  .shader-canvas.is-active {
    opacity: 1;
  }

  /* Keeps body text readable over a moving, colourful background — a fixed
     dark scrim rather than trying to track where text sits. */
  .scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-bg) 46%, transparent);
  }

  :root[data-theme='light'] .atmosphere {
    display: none;
  }
</style>
