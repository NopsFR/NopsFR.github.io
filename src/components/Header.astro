---
// src/components/Header.astro — persistent left sidebar (ref: FEEDBACK app shell)
import tryhackme from '../data/tryhackme.json';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === base) return path === base || path === base.replace(/\/$/, '');
  return path.startsWith(href);
};

const navItems = [
  {
    href: base,
    label: 'Home',
    icon: 'M3 11.5 12 4l9 7.5M5 10v9.5a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10',
  },
  {
    href: `${base}projects`,
    label: 'Projects',
    icon: 'M4 5.5A1.5 1.5 0 0 1 5.5 4h4l1.5 2h9A1.5 1.5 0 0 1 21.5 7.5v11A1.5 1.5 0 0 1 20 20H5.5A1.5 1.5 0 0 1 4 18.5v-13Z',
  },
  {
    href: `${base}credentials`,
    label: 'Credentials',
    icon: 'M12 3.5 4.5 6.5v5c0 5 3.2 8.6 7.5 10 4.3-1.4 7.5-5 7.5-10v-5L12 3.5Z M9.5 12l1.8 1.8L15 10',
  },
  {
    href: `${base}about`,
    label: 'About',
    icon: 'M12 12.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8c.8-3.6 3.6-6 7-6s6.2 2.4 7 6',
  },
];
---

<aside class="sidebar">
  <div class="sidebar-top">
    <a href={base} class="brand">Oscar Portfolio</a>
  </div>

  <nav class="nav" aria-label="Main navigation">
    <span class="nav-label">01 Navigate</span>
    <ul class="nav-list">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
              <svg class="icon" viewBox="0 0 24 24"><path d={item.icon} /></svg>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="sidebar-footer">
    <span>{tryhackme.stats.totalBadges} badges · {tryhackme.stats.totalRoomsCompleted} rooms</span>
    <a href="https://github.com/NopsFR" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub ↗</a>
  </div>
</aside>

<style>
  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    height: 100vh;
    position: sticky;
    top: 0;
  }

  .sidebar-top {
    padding: var(--space-6) var(--space-6) var(--space-4);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-text-primary);
  }

  .brand:hover {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nav {
    flex: 1;
    padding: 0 var(--space-4);
    overflow-y: auto;
  }

  .nav-label {
    display: block;
    padding: 0 var(--space-2);
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .nav-list {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.55rem var(--space-2);
    border-radius: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .nav-link .icon {
    color: var(--color-text-tertiary);
  }

  .nav-link:hover {
    background: var(--color-bg-raised);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nav-link.active {
    background: var(--color-bg-raised);
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .nav-link.active .icon {
    color: var(--color-accent-interactive);
  }

  .sidebar-footer {
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .footer-link {
    color: var(--color-text-secondary);
  }

  @media (max-width: 860px) {
    .sidebar {
      position: static;
      height: auto;
      width: 100%;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .sidebar-top {
      padding: var(--space-4);
    }

    .nav {
      padding: 0 var(--space-2);
      overflow: visible;
    }

    .nav-label {
      display: none;
    }

    .nav-list {
      flex-direction: row;
      margin: 0;
      gap: var(--space-1);
    }

    .nav-link span {
      display: none;
    }

    .sidebar-footer {
      display: none;
    }
  }
</style>
