---
// src/components/Header.astro — persistent left sidebar (ref: FEEDBACK app shell)
import tryhackme from '../data/tryhackme.json';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === base) return path === base || path === base.replace(/\/$/, '');
  return path.startsWith(href);
};

const navItems = [
  {
    href: base,
    label: 'Home',
    icon: 'M3 11.5 12 4l9 7.5M5 10v9.5a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10',
  },
  {
    href: `${base}projects`,
    label: 'Projects',
    icon: 'M4 5.5A1.5 1.5 0 0 1 5.5 4h4l1.5 2h9A1.5 1.5 0 0 1 21.5 7.5v11A1.5 1.5 0 0 1 20 20H5.5A1.5 1.5 0 0 1 4 18.5v-13Z',
  },
  {
    href: `${base}credentials`,
    label: 'Credentials',
    icon: 'M12 3.5 4.5 6.5v5c0 5 3.2 8.6 7.5 10 4.3-1.4 7.5-5 7.5-10v-5L12 3.5Z M9.5 12l1.8 1.8L15 10',
  },
  {
    href: `${base}learning-log`,
    label: 'Learning Log',
    icon: 'M6 4h9l4 4v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z M14.5 4v4.5H19 M9 13h6 M9 16.5h6',
  },
  {
    href: `${base}about`,
    label: 'About',
    icon: 'M12 12.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8c.8-3.6 3.6-6 7-6s6.2 2.4 7 6',
  },
];
---

<aside class="sidebar">
  <div class="sidebar-top">
    <a href={base} class="brand">Oscar Portfolio</a>
  </div>

  <nav class="nav" aria-label="Main navigation">
    <span class="nav-label">01 Navigate</span>
    <ul class="nav-list">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} data-page-link class:list={['nav-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
              <svg class="icon" viewBox="0 0 24 24"><path d={item.icon} /></svg>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="sidebar-footer">
    <button type="button" id="theme-toggle" class="theme-toggle">
      <svg class="icon icon-sun" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="icon icon-moon" viewBox="0 0 24 24">
        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
      </svg>
      <span id="theme-toggle-label">Dark mode</span>
    </button>
    <span class="footer-stat">{tryhackme.stats.totalBadges} badges · {tryhackme.stats.totalRoomsCompleted} rooms</span>
    <a href="https://github.com/NopsFR" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub ↗</a>
  </div>
</aside>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    const label = document.getElementById('theme-toggle-label');
    if (!btn || !label) return;

    function sync() {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      label.textContent = isLight ? 'Light mode' : 'Dark mode';
      btn.setAttribute('aria-pressed', String(isLight));
    }

    btn.addEventListener('click', () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      if (isLight) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', 'light');
      }
      sync();
    });

    sync();
  })();
</script>

<style>
  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    height: 100vh;
    position: sticky;
    top: 0;
  }

  :root[data-theme='light'] .sidebar {
    background: var(--color-surface);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .sidebar-top {
    padding: var(--space-6) var(--space-6) var(--space-4);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-text-primary);
  }

  .brand:hover {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nav {
    flex: 1;
    padding: 0 var(--space-4);
    overflow-y: auto;
  }

  .nav-label {
    display: block;
    padding: 0 var(--space-2);
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .nav-list {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.55rem var(--space-2);
    border-radius: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .nav-link .icon {
    color: var(--color-text-tertiary);
  }

  .nav-link:hover {
    background: var(--color-bg-raised);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nav-link.active {
    background: var(--color-bg-raised);
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .nav-link.active .icon {
    color: var(--color-accent-interactive);
  }

  .sidebar-footer {
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.4rem;
    padding: 0.4rem 0.6rem;
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-family: var(--font-body);
    cursor: pointer;
    width: 100%;
  }

  .theme-toggle:hover {
    background: var(--color-border);
  }

  .icon-sun {
    display: none;
  }

  :root[data-theme='light'] .icon-sun {
    display: block;
  }

  :root[data-theme='light'] .icon-moon {
    display: none;
  }

  .footer-stat {
    color: var(--color-text-tertiary);
  }

  .footer-link {
    color: var(--color-text-secondary);
  }

  @media (max-width: 860px) {
    .sidebar {
      position: static;
      height: auto;
      width: 100%;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .sidebar-top {
      padding: var(--space-4);
    }

    .nav {
      padding: 0 var(--space-2);
      overflow: visible;
    }

    .nav-label {
      display: none;
    }

    .nav-list {
      flex-direction: row;
      margin: 0;
      gap: var(--space-1);
    }

    .nav-link span {
      display: none;
    }

    .sidebar-footer {
      display: none;
    }
  }
</style>
