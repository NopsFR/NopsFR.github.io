---
// src/components/MusicTaste.astro
// "On repeat" — Oscar's Spotify playlists. Names, artwork and track details
// come from Spotify's public oEmbed/embed data (no API keys); artwork is
// served from Spotify's CDN and every item links back to Spotify. The only
// player is Spotify's official embed, compact and lazy-loaded.
//
// Tracks are the first six (one per artist) from the featured playlist, in
// playlist order.
const spotify = 'https://open.spotify.com';
const img = 'https://image-cdn-ak.spotifycdn.com/image/';

const featured = {
  id: '1v9R0H94ZKMEFqGGIbMP0P',
  name: '( •̀ ω •́ )✧',
  art: `${img}ab67706c0000da84d4e8a7775be92b1dde8b8944`,
  count: 51,
};

const tracks = [
  { id: '6Rvi7T8vQkkIYQcp1DWm3u', title: 'vintage vuitton', artist: 'earfzilla', art: 'ab67616d00001e0212d3b2c865fe98d50162f097' },
  { id: '5SBw1xk6yYIUTXbIj9xXHj', title: 'Benny Boy', artist: 'Pink Boy', art: 'ab67616d00001e025e078228e662dd0aab016b7d' },
  { id: '0XPqA1xDFstAQyoVdYead5', title: 'when we were sober', artist: 'comehelpglo', art: 'ab67616d00001e020bb214c1800ec1e4e497cf75' },
  { id: '2hI66u1P8bKLhlrz8fjdrh', title: 'We Get Paper', artist: 'Tommy Fleece', art: 'ab67616d00001e021529b9fc42e80c565909c4a7' },
  { id: '5Q3jWNZzsCSB6SWf2njghn', title: 'Stars', artist: 'Liam Mc Cay', art: 'ab67616d00001e0270579ea55a4ad10393fc3bf0' },
  { id: '6dFgcqb9cskvM7FuHxdQh5', title: 'corpse bride', artist: 'osk', art: 'ab67616d00001e02e2851a0ee492b6b4bc487623' },
];

const more = [
  { id: '6z8AK7S6eJ2sPQTugnwy1i', name: 'ֲֶֶֶֶֹֻת', art: 'ab67706c0000da8437c9cb2c4cd1ff9eb2d53613' },
  { id: '4V2lI46rlgETmv4AX0lSbq', name: '🪽', art: 'ab67706c0000da84cbea39a0735fa2c10c76313e' },
  { id: '35Wmp8GKmbfnhurwavM9qC', name: 'ֱמי', art: 'ab67706c0000da84fd4b16061e7e8a2e27af2aa5' },
];
---

<div class="music">
  <div class="music-head" data-reveal>
    <h3>On repeat</h3>
    <p>What's actually in my ears — straight from my Spotify.</p>
  </div>

  <div class="music-grid">
    <article class="feature" data-reveal>
      <div class="feature-top">
        <img src={featured.art} alt="" width="300" height="300" loading="lazy" decoding="async" />
        <div class="feature-info">
          <p class="meta">Featured playlist · {featured.count} tracks</p>
          <p class="feature-name">{featured.name}</p>
          <a class="btn btn-primary" href={`${spotify}/playlist/${featured.id}`} target="_blank" rel="noopener noreferrer">
            Open in Spotify <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </div>
      </div>
      <iframe
        class="feature-player"
        title="Spotify player: featured playlist"
        src={`${spotify}/embed/playlist/${featured.id}?utm_source=generator&theme=0`}
        width="100%"
        height="152"
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
    </article>

    <ul class="tracks" role="list" data-reveal>
      {
        tracks.map((t) => (
          <li>
            <a class="track" href={`${spotify}/track/${t.id}`} target="_blank" rel="noopener noreferrer">
              <img src={img + t.art} alt="" width="300" height="300" loading="lazy" decoding="async" />
              <span class="track-title">{t.title}</span>
              <span class="track-artist">{t.artist}</span>
              <span class="visually-hidden">— listen on Spotify (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="more" data-reveal>
    <p class="meta">More playlists</p>
    <ul class="more-list" role="list">
      {
        more.map((p) => (
          <li>
            <a class="more-item" href={`${spotify}/playlist/${p.id}`} target="_blank" rel="noopener noreferrer">
              <img src={img + p.art} alt="" width="300" height="300" loading="lazy" decoding="async" />
              <span class="more-name">{p.name}</span>
              <span class="visually-hidden">— playlist on Spotify (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .music {
    margin-top: clamp(3rem, 7vw, 5.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border);
  }

  .music-head {
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .music-head h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
    letter-spacing: -0.015em;
  }

  .music-head p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .music-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }

  @media (max-width: 860px) {
    .music-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--color-bg-raised);
  }

  /* ---- Featured playlist ---- */
  .feature {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background:
      radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--page-accent) 9%, transparent), transparent 60%),
      var(--color-bg-raised);
  }

  .feature-top {
    display: grid;
    grid-template-columns: clamp(96px, 34%, 168px) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: end;
  }

  .feature-top img {
    border-radius: 0.5rem;
    box-shadow: 0 18px 40px -22px color-mix(in srgb, var(--page-accent) 55%, transparent);
  }

  .feature-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    min-width: 0;
  }

  .feature-name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .feature-player {
    display: block;
    border: 0;
    border-radius: 12px;
    background: var(--color-bg);
  }

  /* ---- Track cards ---- */
  .tracks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 480px) {
    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .track,
  .more-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: inherit;
    text-decoration: none;
  }

  .track img,
  .more-item img {
    margin-bottom: var(--space-2);
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    transition: translate var(--transition-slow), border-color var(--transition-safe), box-shadow var(--transition-safe);
  }

  .track:hover img,
  .more-item:hover img {
    translate: 0 -3px;
    border-color: color-mix(in srgb, var(--page-accent) 55%, var(--color-border));
    box-shadow: 0 16px 30px -20px color-mix(in srgb, var(--page-accent) 60%, transparent);
  }

  .track:hover,
  .more-item:hover {
    color: inherit;
  }

  .track-title,
  .more-name {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
    transition: color var(--transition-safe);
  }

  .track:hover .track-title,
  .more-item:hover .more-name {
    color: var(--page-accent);
  }

  .track-artist {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-tertiary);
  }

  /* ---- More playlists ---- */
  .more {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .more .meta {
    margin: 0 0 var(--space-3);
  }

  .more-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 160px));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .track:hover img,
    .more-item:hover img {
      translate: none;
    }
  }
</style>
