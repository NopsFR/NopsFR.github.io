---
// src/components/PageHeader.astro
// Page identity for secondary routes: index + label in the page accent, a
// strong display title, a constrained lede, and a rule that draws in. The
// pieces carry data-reveal so they enter in reading order (identity →
// heading → supporting copy) as the page transition opens.
interface Props {
  index: string;
  label: string;
  title: string;
}
const { index, label, title } = Astro.props;
---

<header class="page-header wrap">
  <p class="ph-meta" data-reveal>
    <span class="ph-index">{index}</span>
    <span class="ph-line" aria-hidden="true"></span>
    <span class="ph-label">{label}</span>
  </p>
  <h1 class="ph-title" data-reveal>{title}</h1>
  <div class="ph-lede" data-reveal><slot /></div>
  <span class="ph-rule" data-reveal="line" aria-hidden="true"></span>
</header>

<style>
  .page-header {
    position: relative;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .ph-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-shadow: 0 0 1px var(--color-bg), 0 1px 4px var(--color-bg), 0 0 14px var(--color-bg);
  }

  .ph-index {
    color: var(--page-accent);
  }

  .ph-line {
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, var(--page-accent), transparent);
  }

  .ph-label {
    color: var(--color-text-tertiary);
  }

  .ph-title {
    margin: 0;
    max-width: 16ch;
    font-size: var(--text-5xl);
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .ph-lede {
    max-width: 62ch;
    margin-top: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .ph-lede :global(p) {
    margin: 0;
  }

  .ph-lede :global(a) {
    color: var(--color-accent-interactive);
  }

  .ph-rule {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--page-accent), color-mix(in srgb, var(--page-accent-2) 45%, transparent) 35%, var(--color-border) 70%, transparent);
  }
</style>
