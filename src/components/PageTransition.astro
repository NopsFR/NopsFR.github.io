---
// src/components/PageTransition.astro
// A fast circular wipe expanding from the clicked point — replaces the old
// pulsing-dot loader. Links opt in via `data-page-link` (primary nav + project cards).
---

<div class="page-transition" data-page-transition aria-hidden="true" inert>
  <p class="page-transition__message">
    <span class="visually-hidden">Loading</span>
  </p>
  <button class="page-transition__skip" type="button">Skip</button>
</div>

<script>
  import { mountPageTransition } from '../scripts/page-transition';
  mountPageTransition();
</script>

<style>
  .page-transition {
    --origin-x: 50%;
    --origin-y: 50%;
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background: var(--color-bg);
    clip-path: circle(0% at var(--origin-x) var(--origin-y));
    transition: clip-path 0.42s var(--ease-out-expo);
    pointer-events: none;
  }

  .page-transition::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--origin-x) var(--origin-y), color-mix(in srgb, var(--color-accent-interactive) 14%, transparent), transparent 55%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .page-transition.is-active {
    clip-path: circle(150% at var(--origin-x) var(--origin-y));
    pointer-events: auto;
  }

  .page-transition.is-active::before {
    opacity: 1;
  }

  .page-transition__skip {
    position: absolute;
    bottom: var(--space-8);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-secondary);
    border-radius: 0.4rem;
    padding: 0.4rem 0.9rem;
    font-size: var(--text-xs);
    cursor: pointer;
    opacity: 0;
  }

  .page-transition__skip:focus-visible {
    opacity: 1;
    color: var(--color-text-primary);
    border-color: var(--color-text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .page-transition {
      transition: none;
    }

    .page-transition::before {
      transition: none;
    }
  }
</style>
