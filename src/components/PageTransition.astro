---
// src/components/PageTransition.astro
// Cross-page transition scene. Leaving: two diagonal planes sweep in from the
// right (accent edge first, dark plane behind it) while the current page
// drifts left; a CSS-3D gyroscopic lattice spins up in the destination's
// accent with the destination's name + path beneath it. Arriving: the next
// page boots already covered (see the inline script in Layout's <head>),
// then the planes continue leftward to reveal it — one continuous motion
// across a hard navigation. Label text is injected via CSS custom
// properties so it paints before any body script runs.
const ribs = Array.from({ length: 6 }, (_, i) => i);
---

<div class="pt" data-pt aria-hidden="true">
  <div class="pt-plane pt-plane-accent"></div>
  <div class="pt-plane pt-plane-dark"></div>
  <div class="pt-scene">
    <div class="pt-object">
      <span class="pt-halo"></span>
      <div class="pt-gyro">
        <svg class="pt-ring pt-ring-a" viewBox="0 0 200 200">
          <polygon points="100,8 180,54 180,146 100,192 20,146 20,54"></polygon>
          <circle cx="100" cy="8" r="3.2"></circle><circle cx="180" cy="146" r="3.2"></circle><circle cx="20" cy="146" r="3.2"></circle>
        </svg>
        <svg class="pt-ring pt-ring-b" viewBox="0 0 200 200">
          <polygon points="100,8 180,54 180,146 100,192 20,146 20,54"></polygon>
          <circle cx="180" cy="54" r="3.2"></circle><circle cx="100" cy="192" r="3.2"></circle><circle cx="20" cy="54" r="3.2"></circle>
        </svg>
        <svg class="pt-ring pt-ring-c" viewBox="0 0 200 200">
          <polygon points="100,20 178,160 22,160"></polygon>
        </svg>
        {ribs.map((i) => <span class="pt-rib" style={`--i:${i}`}></span>)}
      </div>
      <span class="pt-core"></span>
    </div>
    <div class="pt-label">
      <span class="pt-index"></span>
      <span class="pt-title"></span>
      <span class="pt-path"></span>
    </div>
  </div>
</div>

<script>
  import { mountPageTransition } from '../scripts/page-transition';
  mountPageTransition();
</script>

<style>
  .pt {
    --pt-a: var(--page-accent);
    --pt-b: var(--page-accent-2);
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .pt-plane {
    position: absolute;
    inset: 0;
    clip-path: polygon(112% 0, 112% 0, 100% 100%, 100% 100%);
    will-change: clip-path;
  }

  .pt-plane-accent {
    background: linear-gradient(115deg, var(--pt-a), var(--pt-b));
  }

  .pt-plane-dark {
    background:
      radial-gradient(ellipse 55% 45% at 50% 44%, color-mix(in srgb, var(--pt-a) 16%, transparent), transparent 70%),
      var(--color-bg);
  }

  .pt-scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 34px;
    opacity: 0;
  }

  /* ---- the object: a gyroscopic lattice (two hex rings, a triangle, a rib cage) */
  .pt-object {
    position: relative;
    width: 190px;
    height: 190px;
    perspective: 900px;
    transform: scale(0.55);
    opacity: 0;
  }

  .pt-gyro {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    animation: pt-spin 3.4s linear infinite;
  }

  .pt-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke-width: 1.2;
  }

  .pt-ring polygon {
    vector-effect: non-scaling-stroke;
  }

  .pt-ring-a {
    stroke: var(--pt-a);
    filter: drop-shadow(0 0 5px var(--pt-a));
    animation: pt-ring-a 2.6s linear infinite;
  }

  .pt-ring-a circle {
    fill: var(--pt-a);
  }

  .pt-ring-b {
    stroke: var(--pt-b);
    filter: drop-shadow(0 0 5px var(--pt-b));
    animation: pt-ring-b 3.6s linear infinite;
  }

  .pt-ring-b circle {
    fill: var(--pt-b);
  }

  .pt-ring-c {
    stroke: color-mix(in srgb, var(--color-cream) 70%, transparent);
    animation: pt-ring-c 4.4s linear infinite;
  }

  .pt-rib {
    position: absolute;
    left: 50%;
    top: 12%;
    width: 1px;
    height: 76%;
    background: linear-gradient(transparent, color-mix(in srgb, var(--pt-a) 75%, transparent), transparent);
    transform: rotateY(calc(var(--i) * 30deg)) translateZ(52px);
  }

  .pt-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    background: var(--color-cream);
    transform: rotate(45deg);
    box-shadow:
      0 0 14px 3px var(--pt-a),
      0 0 44px 12px color-mix(in srgb, var(--pt-a) 35%, transparent);
    animation: pt-pulse 1.2s ease-in-out infinite alternate;
  }

  .pt-halo {
    position: absolute;
    inset: -40%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--pt-a) 22%, transparent), transparent 62%);
  }

  @keyframes pt-spin {
    from { transform: rotateX(-16deg) rotateY(0deg); }
    to { transform: rotateX(-16deg) rotateY(360deg); }
  }
  @keyframes pt-ring-a {
    from { transform: rotateX(72deg) rotateZ(0deg); }
    to { transform: rotateX(72deg) rotateZ(360deg); }
  }
  @keyframes pt-ring-b {
    from { transform: rotateY(68deg) rotateZ(0deg); }
    to { transform: rotateY(68deg) rotateZ(-360deg); }
  }
  @keyframes pt-ring-c {
    from { transform: rotateX(-38deg) rotateY(34deg) rotateZ(0deg) scale(0.6); }
    to { transform: rotateX(-38deg) rotateY(34deg) rotateZ(360deg) scale(0.6); }
  }
  @keyframes pt-pulse {
    to { transform: rotate(45deg) scale(1.35); }
  }

  /* ---- label */
  .pt-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    max-width: 88vw;
    text-align: center;
    transform: translateY(12px);
    opacity: 0;
  }

  .pt-index {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    color: var(--pt-a);
  }
  .pt-index::before { content: var(--pt-index, ''); }

  .pt-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 46px);
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-cream);
  }
  .pt-title::before { content: var(--pt-title, ''); }

  .pt-path {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-tertiary);
  }
  .pt-path::before { content: var(--pt-path, ''); }

  /* ---- leaving: planes sweep in from the right, scene assembles */
  :global(html.pt-leaving) .pt,
  :global(html.pt-incoming) .pt {
    pointer-events: auto;
  }

  :global(html.pt-leaving) .pt-plane {
    clip-path: polygon(-12% 0, 100% 0, 100% 100%, 0 100%);
    transition: clip-path 0.46s cubic-bezier(0.7, 0, 0.2, 1);
  }
  :global(html.pt-leaving) .pt-plane-dark {
    transition-delay: 0.07s;
  }
  :global(html.pt-leaving) .pt-scene {
    opacity: 1;
    transition: opacity 0.2s ease 0.22s;
  }
  :global(html.pt-leaving) .pt-object {
    opacity: 1;
    transform: scale(1);
    transition: transform 0.5s var(--ease-out-expo) 0.2s, opacity 0.25s ease 0.2s;
  }
  :global(html.pt-leaving) .pt-label {
    opacity: 1;
    transform: none;
    transition: transform 0.4s var(--ease-out-expo) 0.28s, opacity 0.3s ease 0.28s;
  }

  /* ---- arriving: already covered on first paint */
  :global(html.pt-incoming) .pt-plane {
    clip-path: polygon(-12% 0, 100% 0, 100% 100%, 0 100%);
  }
  :global(html.pt-incoming) .pt-scene,
  :global(html.pt-incoming) .pt-object,
  :global(html.pt-incoming) .pt-label {
    opacity: 1;
    transform: none;
  }

  /* ---- revealing: planes keep travelling left, object passes "through" the viewer */
  :global(html.pt-revealing) .pt-plane {
    clip-path: polygon(-12% 0, -12% 0, -24% 100%, -24% 100%);
    transition: clip-path 0.52s cubic-bezier(0.7, 0, 0.2, 1);
  }
  :global(html.pt-revealing) .pt-plane-accent {
    transition-delay: 0.07s;
  }
  :global(html.pt-revealing) .pt-scene {
    opacity: 0;
    transition: opacity 0.26s ease;
  }
  :global(html.pt-revealing) .pt-object {
    transform: scale(1.5);
    transition: transform 0.45s var(--ease-out-expo);
  }

  @media (max-width: 640px) {
    .pt-object {
      width: 150px;
      height: 150px;
    }
  }
</style>
