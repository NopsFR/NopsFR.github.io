---
// src/components/PageTransition.astro
// A clean, minimal fade for internal navigation — a dark veil with a small
// pulsing mark. Links opt in via `data-page-link` (primary nav + project cards).
---

<div class="page-transition" data-page-transition aria-hidden="true" inert>
  <span class="page-transition__mark" aria-hidden="true"></span>
  <p class="page-transition__message">
    <span class="visually-hidden">Loading</span>
  </p>
  <button class="page-transition__skip" type="button">Skip</button>
</div>

<script>
  import { mountPageTransition } from '../scripts/page-transition';
  mountPageTransition();
</script>

<style>
  .page-transition {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    background: var(--color-bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .page-transition.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .page-transition__mark {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-accent-interactive);
    box-shadow: 0 0 0 0 rgba(255, 42, 58, 0.5);
    animation: page-transition-pulse 1s ease-out infinite;
  }

  .page-transition__skip {
    position: absolute;
    bottom: var(--space-8);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-secondary);
    border-radius: 0.4rem;
    padding: 0.4rem 0.9rem;
    font-size: var(--text-xs);
    cursor: pointer;
    opacity: 0;
  }

  .page-transition__skip:focus-visible {
    opacity: 1;
    color: var(--color-text-primary);
    border-color: var(--color-text-secondary);
  }

  @keyframes page-transition-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 42, 58, 0.5);
    }
    100% {
      box-shadow: 0 0 0 22px rgba(255, 42, 58, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-transition__mark {
      animation: none;
    }
  }
</style>
