---
// src/components/ParticleHero.astro
// Big hero title made of particles that react to the pointer. Falls back to a
// normal styled heading on reduced-motion, no WebGL, or narrow/mobile viewports.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="particle-hero">
  <canvas data-title-particles data-title={title} class="particle-hero__canvas" aria-hidden="true"></canvas>
  <h1 data-title-fallback class="particle-hero__fallback">{title}</h1>
</div>

<script>
  // Plain (non define:vars) script so Vite correctly rewrites the dynamic
  // import specifier to the built chunk path — define:vars scripts are
  // injected as inline classic scripts and don't get that rewrite, which
  // 404s in the production build.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-title-particles]');
  const title = canvas?.dataset.title;
  if (canvas && title) {
    import('../scripts/title-particles').then(({ mountTitleParticles }) => {
      mountTitleParticles('[data-title-particles]', title).then((cleanup) => {
        if (cleanup) {
          canvas.classList.add('is-active');
          document.querySelector('[data-title-fallback]')?.classList.add('is-hidden');
        }
      });
    });
  }
</script>

<style>
  .particle-hero {
    position: relative;
    width: 100%;
    height: clamp(140px, 16vw, 320px);
    margin: var(--space-2) calc(-1 * var(--space-2)) 0;
  }

  .particle-hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .particle-hero__canvas.is-active {
    opacity: 1;
  }

  /* Particles are rendered white-on-transparent; invert for legibility on
     the light theme's near-white background instead of re-rendering them. */
  :root[data-theme='light'] .particle-hero__canvas {
    filter: invert(1);
  }

  .particle-hero__fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    font-size: clamp(2rem, 6vw, 3.25rem);
    margin: 0;
    transition: opacity 0.3s ease;
  }

  .particle-hero__fallback.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
</style>
