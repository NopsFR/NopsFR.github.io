---
// src/components/ParticleName.astro
// Host for the particle name (src/scripts/particle-name.ts). There is no
// visible container: separation from the moving background comes from a
// soft pool of shadow behind the name, and the "frame" is only hairlines +
// corner ticks that fade in while the pointer is over it. The real <h1>
// stays in the DOM for screen readers and as the no-JS/no-canvas fallback.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="pn" data-pn>
  <span class="pn-shade" aria-hidden="true"></span>
  <span class="pn-light" aria-hidden="true"></span>
  <canvas class="pn-canvas" data-pn-canvas aria-hidden="true"></canvas>
  <h1 class="pn-title" data-pn-title>{title}</h1>
  <span class="pn-hair pn-hair-top" aria-hidden="true"></span>
  <span class="pn-hair pn-hair-bottom" aria-hidden="true"></span>
  <span class="pn-tick pn-tl" aria-hidden="true"></span>
  <span class="pn-tick pn-tr" aria-hidden="true"></span>
  <span class="pn-tick pn-bl" aria-hidden="true"></span>
  <span class="pn-tick pn-br" aria-hidden="true"></span>
</div>

<script>
  import { mountParticleName } from '../scripts/particle-name';

  const host = document.querySelector<HTMLElement>('[data-pn]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-pn-canvas]');
  const title = document.querySelector<HTMLElement>('[data-pn-title]');
  if (host && canvas && title) {
    mountParticleName(canvas, host, title.textContent?.trim() || '').then((cleanup) => {
      if (cleanup) host.classList.add('is-live');
    });

    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let raf = 0;
      host.addEventListener('pointermove', (e) => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const r = host.getBoundingClientRect();
          host.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
          host.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
        });
      });
    }
  }
</script>

<style>
  .pn {
    --mx: 30%;
    --my: 50%;
    position: relative;
    height: clamp(110px, 17vw, 250px);
    margin: var(--space-4) 0 var(--space-6);
  }

  /* Lighting, not a box: a soft shadow pool behind the name and a cursor light. */
  .pn-shade {
    position: absolute;
    inset: -18% 0;
    background: radial-gradient(ellipse 58% 60% at 40% 52%, color-mix(in srgb, var(--color-bg) 70%, transparent), transparent 72%);
    pointer-events: none;
  }

  .pn-light {
    position: absolute;
    inset: -30% 0;
    background: radial-gradient(360px circle at var(--mx) var(--my), color-mix(in srgb, var(--page-accent) 16%, transparent), transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 45%, transparent 85%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 45%, transparent 85%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .pn-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .pn-title {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 10vw, 9.5rem);
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    color: var(--color-text-primary);
    transition: opacity 0.4s ease;
  }

  .pn.is-live .pn-canvas {
    opacity: 1;
  }

  /* Visually hidden once the particles are live — still read by screen readers. */
  .pn.is-live .pn-title {
    opacity: 0;
    pointer-events: none;
  }

  /* Hairlines + corner ticks: the only "frame", and only on interaction. */
  .pn-hair {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--color-text-primary) 22%, transparent) 20%, color-mix(in srgb, var(--page-accent) 55%, transparent) 50%, color-mix(in srgb, var(--color-text-primary) 22%, transparent) 80%, transparent);
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 0.4s ease,
      transform 0.6s var(--ease-out-expo);
    pointer-events: none;
  }

  .pn-hair-top {
    top: 0;
  }

  .pn-hair-bottom {
    bottom: 0;
  }

  .pn-tick {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: color-mix(in srgb, var(--color-text-primary) 40%, transparent);
    border-style: solid;
    border-width: 0;
    opacity: 0.25;
    transition:
      opacity 0.3s ease,
      border-color 0.3s ease;
    pointer-events: none;
  }

  .pn-tl { top: -1px; left: -1px; border-top-width: 1px; border-left-width: 1px; }
  .pn-tr { top: -1px; right: -1px; border-top-width: 1px; border-right-width: 1px; }
  .pn-bl { bottom: -1px; left: -1px; border-bottom-width: 1px; border-left-width: 1px; }
  .pn-br { bottom: -1px; right: -1px; border-bottom-width: 1px; border-right-width: 1px; }

  .pn:hover .pn-hair {
    opacity: 1;
    transform: scaleX(1);
  }

  .pn:hover .pn-light {
    opacity: 1;
  }

  .pn:hover .pn-tick {
    opacity: 1;
    border-color: var(--page-accent);
  }

  @media (max-width: 640px) {
    .pn {
      margin: var(--space-2) 0 var(--space-4);
    }
  }
</style>
