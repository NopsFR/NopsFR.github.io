---
// src/components/ProjectCard.astro
import StatusBadge from './StatusBadge.astro';

export interface Props {
  slug: string;
  title: string;
  description: string;
  status: 'Production' | 'Active' | 'Learning' | 'Archived';
  projectType: string;
  technologies: Record<string, string[]>;
  logo?: string;
}

const { slug, title, description, status, projectType, technologies, logo } = Astro.props;
const allTech = Object.values(technologies).flat();
const base = import.meta.env.BASE_URL;
---

<a href={`${base}projects/${slug}`} data-page-link class="project-card">
  <div class="card-header">
    {logo && <img src={logo} alt="" class="card-logo" loading="lazy" width="28" height="28" />}
    <div class="card-heading">
      <span class="project-type">{projectType}</span>
      <h3>{title}</h3>
    </div>
    <StatusBadge status={status} />
  </div>
  <p class="description">{description}</p>
  <p class="tech-line">{allTech.join(' · ')}</p>
</a>

<style>
  .project-card {
    display: block;
    padding: var(--space-6);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    color: inherit;
    transition:
      border-color var(--transition-safe),
      transform var(--transition-fast);
  }

  .project-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .card-logo {
    border-radius: 0.25rem;
    object-fit: cover;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .card-heading {
    flex: 1;
    min-width: 0;
  }

  .project-type {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-1);
  }

  h3 {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-text-primary);
  }

  .description {
    margin: 0 0 var(--space-4) 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .tech-line {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-tag);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
