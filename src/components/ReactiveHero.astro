---
// src/components/ReactiveHero.astro
// A cursor-reactive light field behind the title — no dots, no line motifs.
// The moving WebGL background (AtmosphericBackground) already carries the
// "wow" factor; this adds a tight, local spotlight that tracks the pointer
// and strong oversized display type. Degrades to a static glow on touch and
// under prefers-reduced-motion.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="reactive-hero" data-reactive-hero>
  <span class="hero-glow" aria-hidden="true"></span>
  <h1 class="hero-title">{title}</h1>
</div>

<script>
  const hero = document.querySelector<HTMLElement>('[data-reactive-hero]');
  if (hero && window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        const rect = hero.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        hero.style.setProperty('--mx', `${x}%`);
        hero.style.setProperty('--my', `${y}%`);
        raf = 0;
      });
    });
    hero.addEventListener('pointerleave', () => {
      hero.style.setProperty('--mx', '50%');
      hero.style.setProperty('--my', '40%');
    });
  }
</script>

<style>
  .reactive-hero {
    --mx: 30%;
    --my: 40%;
    position: relative;
    padding: var(--space-8) 0 var(--space-4);
    margin: 0 calc(-1 * var(--space-2));
  }

  .hero-glow {
    position: absolute;
    inset: -20% -10%;
    background: radial-gradient(480px circle at var(--mx) var(--my), color-mix(in srgb, var(--color-accent-interactive) 22%, transparent), transparent 70%);
    transition: background 0.4s var(--ease-out-expo);
    pointer-events: none;
    z-index: 0;
  }

  .hero-title {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.95;
    font-size: var(--text-5xl);
    color: var(--color-text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow {
      background: radial-gradient(480px circle at 30% 40%, color-mix(in srgb, var(--color-accent-interactive) 16%, transparent), transparent 70%);
    }
  }
</style>
