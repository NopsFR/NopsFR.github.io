---
// src/components/SpaceBackground.astro
// Full-screen cinematic background. Lazy-loads the Three.js scene after first
// paint; a pure-CSS static field (no images, no JS) is the default look and
// stays visible as the permanent base layer either way.
---

<div class="space-backdrop" aria-hidden="true">
  <div class="space-static"></div>
  <canvas data-space-canvas class="space-canvas"></canvas>
</div>

<script>
  const idle = (cb: () => void) => {
    const ric = (window as typeof window & { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback;
    if (ric) ric(cb);
    else window.setTimeout(cb, 200);
  };

  idle(() => {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-space-canvas]');
    if (!canvas) return;
    // Dynamic import — the three.js bundle is only fetched once idle fires,
    // well after first paint, so it never blocks or competes with text/LCP.
    import('../scripts/space-background').then(({ mountSpaceBackground }) => {
      const cleanup = mountSpaceBackground('[data-space-canvas]');
      if (cleanup) canvas.classList.add('is-active');
    });
  });
</script>

<style>
  .space-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .space-static {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 40% at 20% 15%, rgba(255, 42, 58, 0.08), transparent 60%),
      radial-gradient(ellipse 50% 35% at 80% 70%, rgba(237, 233, 224, 0.05), transparent 60%),
      var(--color-bg);
  }

  .space-static::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(237, 233, 224, 0.6), transparent),
      radial-gradient(1px 1px at 30% 70%, rgba(237, 233, 224, 0.5), transparent),
      radial-gradient(1px 1px at 50% 40%, rgba(255, 69, 80, 0.6), transparent),
      radial-gradient(1px 1px at 70% 85%, rgba(237, 233, 224, 0.4), transparent),
      radial-gradient(1px 1px at 85% 25%, rgba(237, 233, 224, 0.5), transparent),
      radial-gradient(1px 1px at 92% 60%, rgba(255, 69, 80, 0.4), transparent),
      radial-gradient(1px 1px at 15% 55%, rgba(237, 233, 224, 0.4), transparent),
      radial-gradient(1px 1px at 60% 15%, rgba(237, 233, 224, 0.5), transparent);
    background-repeat: repeat;
    background-size: 100% 100%;
  }

  .space-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .space-canvas.is-active {
    opacity: 1;
  }

  :root[data-theme='light'] .space-backdrop {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .space-canvas {
      display: none;
    }
  }
</style>
