---
// src/components/StatusBadge.astro
export interface Props {
  status: 'Production' | 'Active' | 'Learning' | 'Archived';
}

const { status } = Astro.props;

const statusMap: Record<Props['status'], { label: string; color: string }> = {
  Production: { label: 'Production', color: '#3fb950' },
  Active: { label: 'Active', color: '#d29922' },
  Learning: { label: 'Learning', color: '#db6d28' },
  Archived: { label: 'Archived', color: '#7a7a7a' },
};

const { label, color } = statusMap[status];
---

<span class="status-badge" style={`--badge-color: ${color}`}>
  <span class="dot" aria-hidden="true"></span>{label}
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--color-text-secondary);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--badge-color);
    flex-shrink: 0;
  }
</style>
