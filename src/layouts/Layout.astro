---
// src/layouts/Layout.astro
import '@fontsource-variable/inter';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AtmosphericBackground from '../components/AtmosphericBackground.astro';
import PageTransition from '../components/PageTransition.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const site = 'Oscar Portfolio';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || `${site} — Cybersecurity apprenticeship portfolio`} />
    <title>{title} — {site}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={Astro.url} />
    <meta name="theme-color" content="#0B0B0D" />
    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme.
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          if (theme === 'light') document.documentElement.setAttribute('data-theme', 'light');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <AtmosphericBackground />
    <div class="app-shell">
      <Header />
      <div class="app-content">
        <main>
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <PageTransition />
    <script>
      import { mountReveal } from '../scripts/reveal';
      import { mountSpotlight } from '../scripts/spotlight';
      import { mountTypewriter } from '../scripts/typewriter';
      mountReveal();
      mountSpotlight();
      mountTypewriter();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/global.css';
  @import '../styles/animations.css';

  .app-shell {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100vh;
  }

  .app-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .app-content main {
    flex: 1;
  }

  @media (max-width: 860px) {
    .app-shell {
      flex-direction: column;
    }
  }
</style>
