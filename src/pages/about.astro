---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="About Oscar — cybersecurity apprenticeship candidate.">
  <section class="about-content">
    <h1>About</h1>
    <p>
      Final-year Cybersecurity/IT student building production systems: Discord platforms, SaaS marketplaces,
      Rust-based bots, and a self-hosted security lab. Actively practising offensive and defensive security on
      TryHackMe, and applying for a cybersecurity apprenticeship.
    </p>
    <p>
      Get in touch via <a href="https://github.com/NopsFR" target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
  </section>
</Layout>

<style>
  .about-content {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-8);
  }

  .about-content p {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.8;
  }
</style>
