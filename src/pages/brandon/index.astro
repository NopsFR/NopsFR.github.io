---
const base = import.meta.env.BASE_URL;
const pages = Array.from({ length: 53 }, (_, i) => String(i + 1).padStart(2, '0'));
---
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>I.D.K. — Brandon's Comic</title>
<meta name="description" content="I.D.K. — I dunno. A webcomic by Peoplepeopleppl." />
<style>
@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap');
:root{--bg:#0b0b0d;--panel:#111115;--line:#26262d;--text:#f1f0ed;--muted:#a4a2a0;--accent:#b72b38;--accent2:#e34a58;--max:1180px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 50% -20%,#201316 0,#0b0b0d 42%);color:var(--text);font-family:Inter,system-ui,sans-serif}
a{color:inherit;text-decoration:none}.wrap{width:min(calc(100% - 32px),var(--max));margin:auto}
header{position:sticky;top:0;z-index:20;background:rgba(11,11,13,.86);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,.07)}
nav{height:68px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-family:'Archivo Black',sans-serif;letter-spacing:-.04em;font-size:1.25rem}.brand span{color:var(--accent2)}
.navlinks{display:flex;gap:18px;font-size:.86rem;color:var(--muted)}.navlinks a:hover{color:var(--text)}
main{padding:70px 0 100px}.hero{max-width:820px;padding:30px 0 70px}.eyebrow{font:600 .72rem 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:var(--accent2)}
h1{font-family:'Archivo Black',sans-serif;font-size:clamp(4rem,11vw,8.5rem);line-height:.84;letter-spacing:-.065em;margin:18px 0 28px}.hero p{font-size:clamp(1rem,2vw,1.18rem);line-height:1.75;color:#c4c1bf;max-width:720px}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{padding:13px 17px;border:1px solid var(--line);border-radius:9px;font-weight:700;font-size:.9rem;background:#15151a}.btn.primary{background:var(--accent);border-color:var(--accent)}.btn:hover{transform:translateY(-1px)}
.notice{border:1px solid #4b2529;background:rgba(183,43,56,.08);border-radius:12px;padding:18px 20px;color:#d9d1d0;line-height:1.6}.notice strong{color:#fff}
.section-title{display:flex;align-items:end;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:14px;margin:20px 0 18px}.section-title h2{margin:0;font-size:1.1rem}.section-title span{font:500 .72rem 'IBM Plex Mono',monospace;color:var(--muted)}
.archive{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:8px}.page{border:1px solid var(--line);background:var(--panel);border-radius:9px;padding:14px 13px;transition:.18s}.page:hover{border-color:#555;transform:translateY(-2px)}.num{font:600 .7rem 'IBM Plex Mono',monospace;color:var(--accent2)}.page b{display:block;margin-top:7px;font-size:.88rem}
footer{border-top:1px solid var(--line);padding:30px 0;color:var(--muted);font-size:.8rem}.mono{font-family:'IBM Plex Mono',monospace}
@media(max-width:650px){.wrap{width:min(calc(100% - 22px),var(--max))}nav{height:60px}.navlinks{gap:11px;font-size:.76rem}.hero{padding-top:25px}main{padding-top:45px}.archive{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<header><div class="wrap"><nav><a class="brand" href="${base}brandon/">I.D.K.<span>.</span></a><div class="navlinks"><a href="#archive">Archive</a><a href="${base}brandon/read/">Read</a></div></nav></div></header>
<main class="wrap">
<section class="hero"><div class="eyebrow">I.D.K. / I dunno</div><h1>BLACK<br/>TONGUE.</h1>
<p>A dedicated home for Brandon's comic — built around the artwork, with a clean archive and a continuous vertical reader. The comic files can be added later without rebuilding the site structure.</p>
<div class="actions"><a class="btn primary" href="${base}brandon/read/">Start reading →</a><a class="btn" href="#archive">Browse 53 pages</a></div></section>
<section class="notice"><strong>Content warning.</strong> This comic may contain graphic violence/gore, occasional frontal nudity, sexual situations and strong language. Viewer discretion is advised.</section>
<section id="archive" style="padding-top:60px"><div class="section-title"><h2>Archive</h2><span>53 pages · continuous reader</span></div>
<div class="archive">{pages.map((p) => <a class="page" href={`${base}brandon/read/#page-${p}`}><span class="num">PAGE ${p}</span><b>Read page ${p}</b></a>)}</div></section>
</main>
<footer><div class="wrap"><span class="mono">I.D.K.</span> · A comic by Peoplepeopleppl · Site prepared for Brandon</div></footer>
</body></html>