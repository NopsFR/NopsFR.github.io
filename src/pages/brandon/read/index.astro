---
const base = import.meta.env.BASE_URL;
const pages = Array.from({ length: 53 }, (_, i) => String(i + 1).padStart(2, '0'));
---
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Read I.D.K. — I dunno</title>
<style>
:root{--bg:#080809;--panel:#111114;--line:#26262b;--text:#eee;--muted:#9b9998;--accent:#c43342}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif}
a{color:inherit;text-decoration:none}.top{position:sticky;top:0;z-index:30;background:rgba(8,8,9,.9);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,.08)}
.bar{height:62px;max-width:1050px;width:calc(100% - 22px);margin:auto;display:flex;align-items:center;justify-content:space-between;gap:14px}.title{font-weight:800;letter-spacing:-.03em}.controls{display:flex;gap:7px;align-items:center}.control{border:1px solid var(--line);background:#111114;border-radius:8px;padding:8px 11px;font-size:.78rem;color:#d7d5d4}.control:hover{border-color:#555}
.reader{width:min(100%,1050px);margin:auto}.comic{position:relative;min-height:160px;background:var(--panel);border-bottom:1px solid var(--line);display:flex;justify-content:center;align-items:center}
.comic img{display:block;width:auto;max-width:100%;height:auto;max-height:none}.placeholder{padding:70px 20px;text-align:center;color:var(--muted);width:100%}.placeholder .n{font:600 .72rem ui-monospace,monospace;color:#d34a56;letter-spacing:.12em}.placeholder p{margin:10px 0 0;font-size:.82rem}
.comic.loaded .placeholder{display:none}.comic.loaded{background:#000}.backtop{position:fixed;right:15px;bottom:15px;z-index:40}
@media(max-width:650px){.bar{height:56px}.title{font-size:.9rem}.control{padding:7px 9px}.comic img{width:100%}}
</style></head>
<body><header class="top"><div class="bar"><a class="title" href="${base}brandon/">← I.D.K.</a><div class="controls"><a class="control" href="${base}brandon/">Archive</a><a class="control" href="#page-53">End ↓</a></div></div></header>
<main class="reader">{pages.map((p) => <section class="comic" id={`page-${p}`} data-page={p}>
<img src={`${base}brandon/comics/${p}.webp`} alt={`I.D.K. comic page ${p}`} loading={p === '01' ? 'eager' : 'lazy'} />
<div class="placeholder"><div class="n">PAGE ${p}</div><p>Artwork not uploaded yet.</p></div></section>)}</main>
<a class="control backtop" href="#page-01">↑ Top</a>
<script>
document.querySelectorAll('.comic').forEach((comic) => {
 const img = comic.querySelector('img');
 img.addEventListener('load', () => comic.classList.add('loaded'));
 img.addEventListener('error', () => img.remove());
});
</script></body></html>