---
// src/pages/credentials.astro
import Layout from '../layouts/Layout.astro';
import TryHackMeBadge from '../components/TryHackMeBadge.astro';
import SecuritySkills from '../components/SecuritySkills.astro';
import tryhackme from '../data/tryhackme.json';

const { profile, stats, badges, completedRooms, skillsCovered } = tryhackme;
const rarityOrder: Array<'epic' | 'rare' | 'common'> = ['epic', 'rare', 'common'];
---

<Layout title="Credentials" description="TryHackMe badges, completed rooms, and skills — verifying hands-on cybersecurity experience.">
  <section class="credentials-header">
    <h1>Credentials</h1>
    <p>
      Hands-on offensive and defensive security practice, tracked on
      <a href={profile.profileUrl} target="_blank" rel="noopener noreferrer" class="underline-link">TryHackMe</a>.
    </p>

    <dl class="stats-grid">
      <div class="stat">
        <dt>Badges</dt>
        <dd>{stats.totalBadges}</dd>
      </div>
      <div class="stat">
        <dt>Rooms Completed</dt>
        <dd>{stats.totalRoomsCompleted}</dd>
      </div>
      <div class="stat">
        <dt>Epic Badges</dt>
        <dd>{stats.epicBadges}</dd>
      </div>
      <div class="stat">
        <dt>Rare Badges</dt>
        <dd>{stats.rareBadges}</dd>
      </div>
    </dl>
  </section>

  <section class="skills-section">
    <h2>Skills Covered</h2>
    <ul class="skills-list">
      {Object.keys(skillsCovered).map((skill) => <li>{skill}</li>)}
    </ul>
  </section>

  <section class="security-skills-section">
    <h2>Security Specialization</h2>
    <SecuritySkills />
  </section>

  {
    rarityOrder.map((rarity) => (
      <section class="badge-section">
        <h2>{rarity} Badges ({badges[rarity].length})</h2>
        <div class="badge-grid">
          {badges[rarity].map((badge) => (
            <TryHackMeBadge
              title={badge.title}
              description={badge.description}
              rarity={rarity}
              rarityPercent={badge.rarityPercent}
              image={badge.image}
            />
          ))}
        </div>
      </section>
    ))
  }

  <section class="rooms-section">
    <h2>Completed Rooms</h2>
    <p>{completedRooms.totalCompleted} rooms completed. First {completedRooms.sampleFirst16.length} shown below, with the topic tags TryHackMe attaches to each:</p>
    <ul class="rooms-list">
      {
        completedRooms.sampleFirst16.map((room) => (
          <li>
            <div class="room-row">
              <span>{room.title}</span>
              <span class="room-difficulty">{room.difficulty}</span>
            </div>
            <div class="room-tags">
              {room.technologyTags.map((t) => <span class="room-tag">{t}</span>)}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="goals-section">
    <h2>Where I'm headed</h2>
    <p class="goals-intro">
      Stated plainly: these are goals, not claims of current experience. I haven't done live Active Directory
      attack chains, malware analysis, or built custom offensive tooling yet — I'm listing them here because
      they're the specific direction I'm practising toward, not because I've already done them.
    </p>
    <ul class="goals-list">
      <li><strong>Active Directory attack paths</strong> — enumeration, lateral movement, persistence — building on the AD-related TryHackMe rooms above</li>
      <li><strong>Structured malware analysis</strong> (static + dynamic) — a real skill gap right now, not something NEXUS (a deliberately synthetic, non-exploiting training simulator) provides</li>
      <li><strong>Custom security tooling</strong> — none built yet; a natural next step given the scripting already shown in the project work above</li>
      <li><strong>Formal certification</strong> — no certs beyond TryHackMe progress yet; Security+ is the logical next formal step given the foundational rooms already completed</li>
    </ul>
  </section>
</Layout>

<style>
  .credentials-header {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-8) var(--space-8);
  }

  .credentials-header p {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .underline-link {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .stat {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: var(--space-4);
    text-align: center;
  }

  .stat dt {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .stat dd {
    margin: var(--space-2) 0 0;
    font-size: var(--text-2xl);
    font-family: var(--font-mono);
    color: var(--color-accent-interactive);
    text-shadow: 0 0 1px var(--color-bg), 0 1px 4px var(--color-bg), 0 0 14px var(--color-bg);
  }

  section {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-8);
  }

  h2 {
    text-transform: capitalize;
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .skills-list li {
    padding: var(--space-1) var(--space-4);
    background: rgba(255, 42, 58, 0.1);
    border: 1px solid var(--color-accent-interactive);
    border-radius: 1rem;
    font-size: var(--text-sm);
    color: var(--color-accent-tag);
    text-transform: capitalize;
  }

  .badge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .rooms-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .rooms-list li {
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: var(--space-3, 0.75rem) var(--space-4);
  }

  .room-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .room-difficulty {
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
    text-transform: capitalize;
  }

  .room-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .room-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-tertiary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.1rem 0.4rem;
  }

  .goals-section {
    border-top: 2px solid var(--color-border-strong);
  }

  .goals-intro {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    max-width: 700px;
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .goals-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    padding-left: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 700px;
  }

  .goals-list strong {
    color: var(--color-text-primary);
  }

  @media (max-width: 600px) {
    .rooms-list {
      grid-template-columns: 1fr;
    }
  }
</style>
