---
// src/pages/credentials.astro
import Layout from '../layouts/Layout.astro';
import TryHackMeBadge from '../components/TryHackMeBadge.astro';
import tryhackme from '../data/tryhackme.json';

const { profile, stats, badges, completedRooms, skillsCovered } = tryhackme;
const rarityOrder: Array<'epic' | 'rare' | 'common'> = ['epic', 'rare', 'common'];
---

<Layout title="Credentials" description="TryHackMe badges, completed rooms, and skills — verifying hands-on cybersecurity experience.">
  <section class="credentials-header">
    <h1>Credentials</h1>
    <p>
      Hands-on offensive and defensive security practice, tracked on
      <a href={profile.profileUrl} target="_blank" rel="noopener noreferrer">TryHackMe</a>.
    </p>

    <div class="stats-grid">
      <div class="stat">
        <dt>Badges</dt>
        <dd>{stats.totalBadges}</dd>
      </div>
      <div class="stat">
        <dt>Rooms Completed</dt>
        <dd>{stats.totalRoomsCompleted}</dd>
      </div>
      <div class="stat">
        <dt>Epic Badges</dt>
        <dd>{stats.epicBadges}</dd>
      </div>
      <div class="stat">
        <dt>Rare Badges</dt>
        <dd>{stats.rareBadges}</dd>
      </div>
    </div>
  </section>

  <section class="skills-section">
    <h2>Skills Covered</h2>
    <ul class="skills-list">
      {Object.keys(skillsCovered).map((skill) => <li>{skill}</li>)}
    </ul>
  </section>

  {
    rarityOrder.map((rarity) => (
      <section class="badge-section">
        <h2>{rarity} Badges ({badges[rarity].length})</h2>
        <div class="badge-grid">
          {badges[rarity].map((badge) => (
            <TryHackMeBadge
              title={badge.title}
              description={badge.description}
              rarity={rarity}
              rarityPercent={badge.rarityPercent}
              image={badge.image}
            />
          ))}
        </div>
      </section>
    ))
  }

  <section class="rooms-section">
    <h2>Completed Rooms</h2>
    <p>{completedRooms.totalCompleted} rooms completed. First {completedRooms.sampleFirst16.length} shown below:</p>
    <ul class="rooms-list">
      {completedRooms.sampleFirst16.map((room) => <li>{room.title} <span class="room-difficulty">({room.difficulty})</span></li>)}
    </ul>
  </section>
</Layout>

<style>
  .credentials-header {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-8) var(--space-8);
  }

  .credentials-header p {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .stat {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: var(--space-4);
    text-align: center;
  }

  .stat dt {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .stat dd {
    margin: var(--space-2) 0 0;
    font-size: var(--text-2xl);
    font-family: var(--font-mono);
    color: var(--color-accent-interactive);
  }

  section {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-8);
  }

  h2 {
    text-transform: capitalize;
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .skills-list li {
    padding: var(--space-1) var(--space-4);
    background: rgba(255, 42, 58, 0.1);
    border: 1px solid var(--color-accent-interactive);
    border-radius: 1rem;
    font-size: var(--text-sm);
    color: var(--color-accent-tag);
    text-transform: capitalize;
  }

  .badge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .rooms-list {
    columns: 2;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .room-difficulty {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    text-transform: capitalize;
  }

  @media (max-width: 600px) {
    .rooms-list {
      columns: 1;
    }
  }
</style>
