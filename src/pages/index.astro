---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Capabilities from '../components/Capabilities.astro';
import ReactiveHero from '../components/ReactiveHero.astro';
import tryhackme from '../data/tryhackme.json';

const allProjects = await getCollection('projects');
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);
const flagship = sorted.find((p) => p.slug === 'nops-cyber-intelligence')!;
const otherFeatured = sorted.filter((p) => p.data.featured && p.slug !== flagship.slug).slice(0, 4);
const publicRepoCount = allProjects.filter((p) => p.data.links?.github).length;
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Home"
  description="Oscar — security-minded full-stack engineer. Builder of NOPS / Cyber Intelligence, a production threat-intelligence platform, plus real Rust, Tauri and Discord-platform projects."
>
  <section class="hero">
    <span class="eyebrow" data-reveal>Security engineering / full-stack development</span>
    <ReactiveHero title="Oscar Senior" />
    <p class="tagline" data-reveal data-typewriter>Builder of production-shaped systems, security-first.</p>
    <p class="bio" data-reveal>
      I'm Oscar — a final-year DISC student practising offensive and defensive security fundamentals on TryHackMe,
      and shipping real systems: a full threat-intelligence investigation platform, Rust/Tauri desktop apps, and
      Discord-native platforms with real auth, rate limiting, and audit logging. {allProjects.length} projects total,
      every one audited against its own source — what's public is linked, what's private is labelled.
    </p>

    <div class="hero-actions" data-reveal>
      <a href={`${base}projects`} data-page-link class="btn btn-primary">
        <svg class="icon" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        View all work
      </a>
      <a href={`${base}credentials`} data-page-link class="btn btn-outline">
        <svg class="icon" viewBox="0 0 24 24"><path d="M12 3.5 4.5 6.5v5c0 5 3.2 8.6 7.5 10 4.3-1.4 7.5-5 7.5-10v-5L12 3.5Z" /></svg>
        Credentials
      </a>
    </div>

    <dl class="stat-row" data-reveal>
      <div class="stat"><dt>Projects</dt><dd>{allProjects.length}</dd></div>
      <div class="stat"><dt>Public repos</dt><dd>{publicRepoCount}</dd></div>
      <div class="stat"><dt>TryHackMe badges</dt><dd>{tryhackme.stats.totalBadges}</dd></div>
      <div class="stat"><dt>Rooms completed</dt><dd>{tryhackme.stats.totalRoomsCompleted}</dd></div>
    </dl>
  </section>

  <section class="flagship">
    <div class="section-heading" data-reveal>
      <span class="section-kicker">Featured work</span>
      <h2>NOPS / Cyber Intelligence</h2>
    </div>

    <a href={`${base}projects/${flagship.slug}`} data-page-link class="flagship-card" data-reveal>
      <span class="flagship-cover">
        <img src={flagship.data.cover} alt="NOPS investigation workspace — a live investigations table with observable type, mode, status, findings and source coverage" loading="eager" />
      </span>
      <span class="flagship-body">
        <span class="flagship-tagline" data-typewriter>{flagship.data.tagline}</span>
        <span class="flagship-description">{flagship.data.description}</span>
        <span class="flagship-metrics">
          {Object.entries(flagship.data.metrics ?? {}).map(([k, v]) => (
            <span class="flagship-metric"><b class="neon">{v}</b>{k}</span>
          ))}
        </span>
        <span class="flagship-actions">
          <span class="btn btn-primary">Read the case study →</span>
          {flagship.data.links?.live && <span class="btn btn-outline" data-external data-href={flagship.data.links.live}>Live app ↗</span>}
          {flagship.data.links?.github && <span class="btn btn-outline" data-external data-href={flagship.data.links.github}>Source ↗</span>}
        </span>
      </span>
    </a>
  </section>

  <section class="other-work">
    <div class="section-heading" data-reveal>
      <h2>Other projects</h2>
      <a href={`${base}projects`} data-page-link class="view-all">View all {allProjects.length} →</a>
    </div>
    <div class="project-grid">
      {otherFeatured.map((project) => <ProjectCard slug={project.slug} {...project.data} />)}
    </div>
  </section>

  <section class="capabilities-section">
    <div class="section-heading" data-reveal>
      <h2>Technical capabilities</h2>
      <a href={`${base}about`} data-page-link class="view-all">Full breakdown →</a>
    </div>
    <Capabilities />
  </section>

  <section class="journey">
    <div class="journey-inner" data-reveal>
      <div>
        <h2>Still learning, in the open</h2>
        <p>
          {tryhackme.stats.totalBadges} TryHackMe badges and {tryhackme.stats.totalRoomsCompleted} completed rooms,
          tracked honestly — mostly foundational, clearly labelled as exposure rather than mastery. The
          <a href={`${base}learning-log`} data-page-link>learning log</a> lines up every project milestone in order.
        </p>
      </div>
      <div class="journey-links">
        <a href={`${base}credentials`} data-page-link class="btn btn-outline">Credentials</a>
        <a href={`${base}learning-log`} data-page-link class="btn btn-outline">Learning log</a>
      </div>
    </div>
  </section>

  <section class="cta-section" data-reveal>
    <div>
      <h2>Ready to discuss an apprenticeship?</h2>
      <p>Every claim on this site links back to real, inspectable source. Start with <a href="https://github.com/NopsFR" target="_blank" rel="noopener noreferrer">github.com/NopsFR</a>.</p>
    </div>
    <a href={`${base}about`} data-page-link class="btn btn-primary">Get in touch</a>
  </section>
</Layout>

<script>
  // The flagship card is a single anchor (for a large, clickable hit-area);
  // its inner "Live app" / "Source" pills are rendered as spans so they don't
  // create nested <a> tags, and instead open their real target on click.
  document.querySelectorAll<HTMLElement>('.flagship-card [data-external]').forEach((el) => {
    el.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      const url = el.dataset.href;
      if (url) window.open(url, '_blank', 'noopener,noreferrer');
    });
  });
</script>

<style>
  .hero {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-8) var(--space-12);
  }

  .eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-interactive);
    text-shadow: 0 0 1px var(--color-bg), 0 1px 4px var(--color-bg), 0 0 14px var(--color-bg);
    margin-bottom: var(--space-4);
  }

  .tagline {
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin: var(--space-4) 0 var(--space-4);
  }

  .bio {
    max-width: 680px;
    margin: 0 0 var(--space-8);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: var(--space-8);
    margin: 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--color-border);
  }

  .stat dt {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-1);
  }

  .stat dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
  }

  section {
    padding: var(--space-12) var(--space-8);
    max-width: 1400px;
    margin: 0 auto;
  }

  .flagship,
  .other-work,
  .capabilities-section,
  .journey {
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .section-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-interactive);
    text-shadow: 0 0 1px var(--color-bg), 0 1px 4px var(--color-bg), 0 0 14px var(--color-bg);
    margin-bottom: var(--space-2);
  }

  .section-heading h2 {
    margin: 0;
    font-size: var(--text-2xl);
  }

  .view-all {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  /* Flagship (NOPS) */
  .flagship-card {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 1fr);
    gap: 0;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: 1rem;
    overflow: hidden;
    color: inherit;
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.7);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-safe);
  }

  .flagship-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    border-color: var(--color-accent-secondary);
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.7), 0 0 0 1px color-mix(in srgb, var(--color-accent-secondary) 25%, transparent);
  }

  .flagship-cover {
    display: block;
    overflow: hidden;
    background: #000;
    border-right: 1px solid var(--color-border);
  }

  .flagship-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 32% top;
    transform: scale(1.01);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .flagship-card:hover .flagship-cover img {
    transform: scale(1.05);
  }

  .flagship-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
  }

  .flagship-tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .flagship-description {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .flagship-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .flagship-metric {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .flagship-metric b {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-accent-secondary);
    font-weight: 600;
  }

  .flagship-actions {
    display: flex;
    gap: var(--space-3, 0.75rem);
    flex-wrap: wrap;
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .flagship-card {
      grid-template-columns: 1fr;
    }

    .flagship-cover {
      aspect-ratio: 16 / 10;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  /* Learning journey */
  .journey-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .journey-inner h2 {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-2);
  }

  .journey-inner p {
    max-width: 560px;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  .journey-links {
    display: flex;
    gap: var(--space-3, 0.75rem);
    flex-wrap: wrap;
  }

  .cta-section {
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .cta-section h2 {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-2);
  }

  .cta-section p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    margin: 0;
  }
</style>
