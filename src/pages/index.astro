---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Skills from '../components/Skills.astro';
import ParticleHero from '../components/ParticleHero.astro';
import ProjectSpotlight from '../components/ProjectSpotlight.astro';
import tryhackme from '../data/tryhackme.json';

const allProjects = await getCollection('projects');
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);
const featuredProjects = sorted.filter((p) => p.data.featured).slice(0, 3);
const publicRepoCount = allProjects.filter((p) => p.data.links?.github).length;
const spotlight = sorted.find((p) => p.slug === 'feedback')!;
const base = import.meta.env.BASE_URL;
---

<Layout title="Home" description="Cybersecurity apprenticeship portfolio — full-stack development, Rust, Discord platforms, and offensive security labs.">
  <section class="hero">
    <span class="eyebrow">Cybersecurity apprenticeship candidate</span>
    <ParticleHero title="Oscar Senior" />
    <p class="tagline">Security-minded engineer, full-stack builder</p>
    <p class="bio">
      I'm Oscar — a final-year DISC student practising offensive and defensive security fundamentals on TryHackMe,
      and building production-shaped systems with Rust, TypeScript, Tauri, Fastify/NestJS, and Discord platforms —
      most of them with real auth, rate limiting, and audit logging, not just a demo that works once.
      {allProjects.length} real projects, all audited against their own source: what's public is linked, what's
      private is labelled, and what didn't match the code has been rewritten.
    </p>

    <div class="hero-actions">
      <a href={`${base}projects`} data-page-link class="btn btn-primary">
        <svg class="icon" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        View projects
      </a>
      <a href={`${base}credentials`} data-page-link class="btn btn-outline">
        <svg class="icon" viewBox="0 0 24 24"><path d="M12 3.5 4.5 6.5v5c0 5 3.2 8.6 7.5 10 4.3-1.4 7.5-5 7.5-10v-5L12 3.5Z" /></svg>
        Credentials
      </a>
    </div>

    <dl class="stat-row">
      <div class="stat"><dt>Projects</dt><dd>{allProjects.length}</dd></div>
      <div class="stat"><dt>Public repos</dt><dd>{publicRepoCount}</dd></div>
      <div class="stat"><dt>TryHackMe badges</dt><dd>{tryhackme.stats.totalBadges}</dd></div>
      <div class="stat"><dt>Rooms completed</dt><dd>{tryhackme.stats.totalRoomsCompleted}</dd></div>
    </dl>
  </section>

  <section class="spotlight-section">
    <ProjectSpotlight
      href={`${base}projects/${spotlight.slug}`}
      title={spotlight.data.title}
      description={spotlight.data.description}
      cover={`${base}images/feedback-cover.png`}
      cta="View project"
    />
  </section>

  <section class="featured">
    <div class="section-heading">
      <h2>Featured work</h2>
      <a href={`${base}projects`} class="view-all">View all {allProjects.length} →</a>
    </div>
    <div class="project-grid">
      {
        featuredProjects.map((project) => (
          <ProjectCard slug={project.slug} {...project.data} />
        ))
      }
    </div>
  </section>

  <section class="skills-preview">
    <div class="section-heading">
      <h2>Skills</h2>
      <a href={`${base}about`} class="view-all">Full breakdown →</a>
    </div>
    <Skills />
  </section>

  <section class="cta-section">
    <h2>Ready to discuss an apprenticeship?</h2>
    <a href={`${base}about`} class="btn btn-outline">Get in touch</a>
  </section>
</Layout>

<style>
  .hero {
    padding: var(--space-16) var(--space-8) var(--space-12);
    max-width: 760px;
  }

  .eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-interactive);
    margin-bottom: var(--space-4);
  }

  .tagline {
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    margin: var(--space-2) 0 var(--space-4);
  }

  .spotlight-section {
    padding: 0 var(--space-8) var(--space-12);
    max-width: 760px;
  }

  .bio {
    max-width: 620px;
    margin: 0 0 var(--space-8);
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: var(--space-8);
    margin: 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--color-border);
  }

  .stat dt {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-1);
  }

  .stat dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
  }

  .featured {
    padding: var(--space-12) var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .section-heading h2 {
    margin: 0;
    font-size: var(--text-xl);
  }

  .view-all {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  .skills-preview {
    padding: var(--space-12) var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--color-border);
  }

  .cta-section {
    padding: var(--space-16) var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .cta-section h2 {
    font-size: var(--text-xl);
    margin: 0;
  }
</style>
