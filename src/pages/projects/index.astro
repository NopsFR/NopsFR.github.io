---
// src/pages/projects/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const allProjects = await getCollection('projects');
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);
const categories = [...new Set(sorted.map((p) => p.data.projectType))].sort();
---

<Layout title="Projects" description="All projects — full-stack platforms, Rust/Tauri desktop apps, Discord platforms, and security infrastructure.">
  <section class="projects-header">
    <h1>Projects</h1>
    <p>{sorted.length} projects spanning full-stack platforms, systems programming, and security infrastructure.</p>

    <div class="filter-row" role="tablist" aria-label="Filter projects by category">
      <button type="button" class="filter-btn active" data-filter="all">All ({sorted.length})</button>
      {
        categories.map((cat) => (
          <button type="button" class="filter-btn" data-filter={cat}>
            {cat} ({sorted.filter((p) => p.data.projectType === cat).length})
          </button>
        ))
      }
    </div>
  </section>

  <section class="project-grid" id="project-grid">
    {sorted.map((project) => (
      <div class="grid-item" data-category={project.data.projectType}>
        <ProjectCard slug={project.slug} {...project.data} />
      </div>
    ))}
  </section>
</Layout>

<script is:inline>
  (function () {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.grid-item');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.getAttribute('data-filter');
        items.forEach((item) => {
          const match = filter === 'all' || item.getAttribute('data-category') === filter;
          item.style.display = match ? '' : 'none';
        });
      });
    });
  })();
</script>

<style>
  .projects-header {
    padding: var(--space-12) var(--space-8) var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
  }

  .projects-header p {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    margin-bottom: var(--space-6);
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-btn {
    padding: 0.4rem 0.85rem;
    border-radius: 0.4rem;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    cursor: pointer;
    transition:
      background var(--transition-safe),
      color var(--transition-safe),
      border-color var(--transition-safe);
  }

  .filter-btn:hover {
    border-color: var(--color-text-secondary);
    color: var(--color-text-primary);
  }

  .filter-btn.active {
    background: var(--color-cream);
    border-color: var(--color-cream);
    color: var(--color-cream-text);
    font-weight: 600;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-4);
    max-width: 1200px;
    margin: 0 auto var(--space-16);
    padding: 0 var(--space-8);
  }
</style>
